modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_USERNAME = "admin"
superadmin = "Clinic@OS2024"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18150
externalPort = 3000

[[ports]]
localPort = 19460
externalPort = 3001

[[ports]]
localPort = 22067
externalPort = 80

[objectStorage]
defaultBucketID = "replit-objstore-802ace1f-76ec-4d41-be39-689874355740"
